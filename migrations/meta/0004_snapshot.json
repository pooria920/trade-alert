        "alert_rule_type": {
          "name": "alert_rule_type",
          "value": "\"alert_rules\".\"type\" IN ('BUY_QUEUE_DROP_PERCENT', 'SELL_QUEUE_DROP_PERCENT', 'BUY_QUEUE_DISAPPEARED', 'SELL_QUEUE_DISAPPEARED')"
        },
        "alert_rule_threshold": {
          "name": "alert_rule_threshold",
          "value": "(\"alert_rules\".\"type\" NOT IN ('BUY_QUEUE_DROP_PERCENT', 'SELL_QUEUE_DROP_PERCENT')) OR (\"alert_rules\".\"threshold_percent\" IS NOT NULL AND \"alert_rules\".\"threshold_percent\" > 0 AND \"alert_rules\".\"threshold_percent\" <= 100)"
        },
        "alert_rule_window": {
          "name": "alert_rule_window",
          "value": "\"alert_rules\".\"window_minutes\" IN (1, 5)"
        },
        "alert_rule_baseline": {
          "name": "alert_rule_baseline",
          "value": "\"alert_rules\".\"minimum_baseline_volume\" > 0"
        },
        "alert_rule_cooldown": {
          "name": "alert_rule_cooldown",
          "value": "\"alert_rules\".\"cooldown_seconds\" >= 0"
        }
      }
