NODE_ENV=production

TELEGRAM_BOT_TOKEN=
# Required for bot-only Telethon authentication.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional tg://proxy?server=HOST&port=PORT&secret=SECRET or https://t.me/proxy?... link.
# Supports hex or URL-safe Base64 (keep the entire link/domain).
# A manual URL takes priority over automatic discovery. No direct fallback.
TELEGRAM_MTPROXY_URL=
# true: automatically fetch public MTProxy lists and rotate failing proxies; no URL needed.
# false + empty URL: direct connection. Requests to the market remain direct in either mode.
TELEGRAM_PROXY_AUTO=true
TELEGRAM_ALLOWED_USER_IDS=
# Admin IDs must also occur in TELEGRAM_ALLOWED_USER_IDS. Leave both below blank for private-only mode.
TELEGRAM_ADMIN_USER_IDS=
# One exact Telegram channel, basic group or supergroup ID (negative integer).
# The bot must be an administrator. Group commands are limited to the admins above,
# after they start the bot privately. See DEPLOYMENT.fa.md.
TELEGRAM_CHANNEL_ID=

TSETMC_BASE_URL=https://cdn.tsetmc.com/api
TSETMC_REQUEST_TIMEOUT_MS=5000
TSETMC_MAX_RETRIES=2
MARKET_DATA_MAX_AGE_MS=30000

MARKET_POLL_INTERVAL_MS=10000
MARKET_MAX_CONCURRENT_REQUESTS=3
MARKET_REQUEST_TIMEOUT_MS=5000
MARKET_MONITOR_FORCE_ACTIVE=false
# Closed until the operator supplies explicit sessions.
MARKET_SESSION_MARKET=equities
MARKET_SESSIONS_JSON=[]
# Gregorian dates in Tehran; include holidays and exceptional closures.
MARKET_CLOSED_DATES=
SNAPSHOT_RETENTION_HOURS=24
SNAPSHOT_HISTORY_TOLERANCE_SECONDS=20
SNAPSHOT_CLEANUP_INTERVAL_MS=900000

ALERT_DEFAULT_COOLDOWN_SECONDS=300
ALERT_HISTORY_LIMIT=10
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BASE_MS=2000
NOTIFICATION_MAX_AGE_MINUTES=15

DATABASE_URL=/app/data/stock-alert.db
LOG_LEVEL=info
